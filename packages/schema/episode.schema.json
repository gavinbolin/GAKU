{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaku.local/schemas/episode.schema.json",
  "title": "Episode",
  "description": "PROJECT GAKU podcast episode definition. Produced by the Gemini script-gen step and consumed by the audio + video pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "topic",
    "target_duration_minutes",
    "hosts",
    "segments"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable slug used for output filenames (e.g. 'fermentation-001')."
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable topic / title shown on the title card."
    },
    "target_duration_minutes": {
      "type": "number",
      "minimum": 5,
      "maximum": 120,
      "description": "Target finished runtime in minutes."
    },
    "hosts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/Host"
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Segment"
      }
    },
    "series": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "YouTube series key from podcast-pipeline/config/playlist_series.json (e.g. hbr). Written at research time when source is HBR; used to auto-add uploads to the series playlist and format the title tag."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional YouTube tags / topic keywords."
    },
    "thumbnail_hook": {
      "type": "string",
      "description": "Optional 2-4 word YouTube thumbnail hook (Impact-style). When set, hybrid thumb gen uses this instead of topic-word fallback. Episode-folder thumbnail.png still overrides the generated image.",
      "maxLength": 48
    },
    "thumbnail_text": {
      "type": "string",
      "description": "Optional 2-5 word thumbnail headline, separate from the YouTube title (e.g. 'How 3D Animation *Works*'). Wrap the single key word in *asterisks* for the accent colour. Preferred over thumbnail_hook.",
      "maxLength": 60
    },
    "thumbnail_motif": {
      "type": "string",
      "enum": ["rig", "none"],
      "description": "Optional local thumbnail accent graphic. 'rig' draws a wireframe armature; omitted = auto (3D/animation topics)."
    },
    "sources": {
      "type": "array",
      "description": "Where the episode's information came from, captured from research artifacts (never invented). Listed in the YouTube description. Full capture incl. off-topic results lives in <run>/sources.json.",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "origin": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "Host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "voice_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Short identifier referenced by lines (e.g. 'A' or 'B')."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "voice_id": {
          "type": "string",
          "minLength": 1,
          "description": "Kokoro voice identifier. See kokoroClient.ts for available voices."
        }
      }
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "title",
        "lines"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Line"
          }
        },
        "visuals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Visual"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Overlay"
          }
        }
      }
    },
    "QuadrantAxis": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "low": { "type": "string" },
        "high": { "type": "string" }
      }
    },
    "Overlay": {
      "type": "object",
      "required": [
        "type",
        "show_at_line",
        "hide_at_line"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bullets",
            "stat",
            "chart",
            "quadrant"
          ]
        },
        "show_at_line": {
          "type": "number",
          "minimum": 1
        },
        "hide_at_line": {
          "type": "number",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "subtext": {
          "type": "string"
        },
        "chart_type": {
          "type": "string"
        },
        "x_axis": { "$ref": "#/definitions/QuadrantAxis" },
        "y_axis": { "$ref": "#/definitions/QuadrantAxis" },
        "cells": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["label", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" },
              "x": { "enum": ["low", "high", 0, 1] },
              "y": { "enum": ["low", "high", 0, 1] }
            }
          }
        },
        "highlight": { "type": ["string", "number", "null"] },
        "data_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "Line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "host_id",
        "text"
      ],
      "properties": {
        "line_id": {
          "type": "string",
          "minLength": 1
        },
        "host_id": {
          "type": "string",
          "minLength": 1,
          "description": "Must match one of the hosts[].id values."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "pause_after_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 250,
          "description": "Silence inserted after this line during audio concatenation."
        },
        "is_quotable": {
          "type": "boolean",
          "default": false,
          "description": "Flag set by Gemini to mark the single most quotable line of the segment. The coverage queue uses this to auto-generate a PullQuote visual when a gap needs filling."
        }
      }
    },
    "Visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_id",
        "template",
        "duration_ms",
        "data"
      ],
      "properties": {
        "visual_id": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "enum": [
            "TitleCard",
            "GrowthCurve",
            "StatCallout",
            "BookCover",
            "ChapterCard",
            "FlowDiagram",
            "SpeakerCard",
            "PullQuote",
            "KeyTermDefinition",
            "StatAnimation",
            "ConceptComparison",
            "TimelineVisual",
            "PhotoCard",
            "PercentageRing",
            "SegmentCard"
          ]
        },
        "start_with_line": {
          "type": "string",
          "minLength": 1,
          "description": "line_id within the same segment at the START of which this visual appears. Use the segment's first line_id to pin to segment start."
        },
        "start_after_line": {
          "type": "string",
          "minLength": 1,
          "description": "Deprecated alias for start_with_line; kept for backward compatibility with older episode JSONs."
        },
        "duration_ms": {
          "type": "number",
          "minimum": 500,
          "maximum": 60000
        },
        "cue_mode": {
          "type": "string",
          "enum": [
            "after_speech",
            "after_pause"
          ],
          "default": "after_speech",
          "description": "When start_with_line is the END of a line (deprecated start_after_line path), choose whether the visual appears immediately after the speech (after_speech) or after the trailing pause_after_ms silence (after_pause)."
        },
        "data": {
          "type": "object",
          "description": "Template-specific payload. Shape is conditionally validated via oneOf below.",
          "additionalProperties": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "template": {
              "const": "TitleCard"
            },
            "data": {
              "$ref": "#/definitions/TitleCardData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "GrowthCurve"
            },
            "data": {
              "$ref": "#/definitions/GrowthCurveData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "StatCallout"
            },
            "data": {
              "$ref": "#/definitions/StatCalloutData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "BookCover"
            },
            "data": {
              "$ref": "#/definitions/BookCoverData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "ChapterCard"
            },
            "data": {
              "$ref": "#/definitions/ChapterCardData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "FlowDiagram"
            },
            "data": {
              "$ref": "#/definitions/FlowDiagramData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "SpeakerCard"
            },
            "data": {
              "$ref": "#/definitions/SpeakerCardData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "PullQuote"
            },
            "data": {
              "$ref": "#/definitions/PullQuoteData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "KeyTermDefinition"
            },
            "data": {
              "$ref": "#/definitions/KeyTermDefinitionData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "StatAnimation"
            },
            "data": {
              "$ref": "#/definitions/StatAnimationData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "ConceptComparison"
            },
            "data": {
              "$ref": "#/definitions/ConceptComparisonData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "TimelineVisual"
            },
            "data": {
              "$ref": "#/definitions/TimelineVisualData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "PhotoCard"
            },
            "data": {
              "$ref": "#/definitions/PhotoCardData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "PercentageRing"
            },
            "data": {
              "$ref": "#/definitions/PercentageRingData"
            }
          }
        },
        {
          "properties": {
            "template": {
              "const": "SegmentCard"
            },
            "data": {
              "$ref": "#/definitions/SegmentCardData"
            }
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "start_with_line"
          ]
        },
        {
          "required": [
            "start_after_line"
          ]
        }
      ]
    },
    "TitleCardData": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GrowthCurveData": {
      "type": "object",
      "required": [
        "points"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "x_axis_label": {
          "type": "string"
        },
        "y_axis_label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "StatCalloutData": {
      "type": "object",
      "required": [
        "value",
        "caption"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "BookCoverData": {
      "type": "object",
      "required": [
        "title",
        "author"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ChapterCardData": {
      "type": "object",
      "required": [
        "chapter_num",
        "chapter_title"
      ],
      "properties": {
        "chapter_num": {
          "type": "number"
        },
        "chapter_title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "FlowDiagramData": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "active_step": {
          "type": "number"
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        }
      },
      "additionalProperties": false
    },
    "SpeakerCardData": {
      "type": "object",
      "required": [
        "host_name",
        "host_role",
        "color"
      ],
      "properties": {
        "host_name": {
          "type": "string",
          "minLength": 1
        },
        "host_role": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "show_waveform": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "PullQuoteData": {
      "type": "object",
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "speaker": {
          "type": "string"
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        }
      },
      "additionalProperties": false
    },
    "KeyTermDefinitionData": {
      "type": "object",
      "required": [
        "term",
        "definition"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "etymology": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "StatAnimationData": {
      "type": "object",
      "required": [
        "value",
        "caption"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "animate_type": {
          "type": "string",
          "enum": [
            "counter",
            "ring"
          ]
        }
      },
      "additionalProperties": false
    },
    "ConceptComparisonData": {
      "type": "object",
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "left": {
          "$ref": "#/definitions/ComparisonColumn"
        },
        "right": {
          "$ref": "#/definitions/ComparisonColumn"
        },
        "left_color": {
          "type": "string"
        },
        "right_color": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ComparisonColumn": {
      "type": "object",
      "required": [
        "label",
        "points"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "TimelineVisualData": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "year",
              "label"
            ],
            "properties": {
              "year": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "PhotoCardData": {
      "type": "object",
      "required": [
        "photo_url"
      ],
      "properties": {
        "photo_url": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "photographer": {
          "type": "string"
        },
        "overlay_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "PercentageRingData": {
      "type": "object",
      "required": [
        "percentage",
        "label"
      ],
      "properties": {
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string"
        },
        "show_remaining": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SegmentCardData": {
      "type": "object",
      "required": [
        "title",
        "bullets",
        "host_a_name",
        "host_b_name",
        "host_a_color",
        "host_b_color",
        "current_speaker"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "photo_url": {
          "type": "string"
        },
        "host_a_name": {
          "type": "string",
          "minLength": 1
        },
        "host_b_name": {
          "type": "string",
          "minLength": 1
        },
        "host_a_color": {
          "type": "string",
          "minLength": 1
        },
        "host_b_color": {
          "type": "string",
          "minLength": 1
        },
        "current_speaker": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "both"
          ]
        },
        "segment_number": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
